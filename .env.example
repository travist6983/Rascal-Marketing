# Credentials for the social scripts. Copy to `.env` (gitignored) and fill in.
#
# scripts/env.mjs loads `.env` from this directory before anything reads
# process.env. A variable exported in your shell wins over the file.
#
# All three already exist in ../Project-Rascal/.env. Rather than copy the
# values into a second file and have them drift at the next rotation:
#
#     ln -s ../Project-Rascal/.env .env
#
# docs/social-posting.md says where each one comes from.

# npm run social:captions
ANTHROPIC_API_KEY=

# npm run social:post -- --live
IG_USER_ID=
IG_ACCESS_TOKEN=

# Optional. Where the committed social/queue/*.jpg are publicly readable.
# Defaults to raw.githubusercontent.com for this repo.
SOCIAL_IMAGE_BASE=
